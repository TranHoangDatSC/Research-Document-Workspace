# Copy thành .env trên VPS (KHÔNG dùng lại 3 password đã dùng khi demo local).
# Không đổi tên DB/user/password khi đã có volume dữ liệu (xem README).

# PostgreSQL
POSTGRES_DB=research_document_workspace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MONGO_DB=research_document_workspace

# MinIO (password tối thiểu 8 ký tự)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MINIO_BUCKET=research-documents-workspace

# Redis: bộ đếm giới hạn tần suất dùng chung (xem docs/ha-tang.md mục 13).
# Chỉ dùng chữ, số, "-" và "_" (mật khẩu được ghép vào URL redis://).
# Tạo: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Đăng nhập — xem ghi chú trong .env.example. Tạo SESSION_SECRET mới, KHÔNG
# dùng lại giá trị đã dùng ở máy demo local.
# Tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Bootstrap TỪ CHỐI khởi động trên production nếu còn giá trị REPLACE_WITH…
# hoặc SESSION_SECRET ngắn hơn 32 ký tự.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Hỏi đáp AI — xem hướng dẫn lấy key miễn phí + cơ chế tự xoay model/key khi
# gặp lỗi 503/429 trong .env.example. Có thể dùng lại cùng key ở local và VPS
# (free tier tính theo tài khoản Google, không theo máy chủ).
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
# LLM_API_KEYS=key-thu-nhat,key-thu-hai
# LLM_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# Caddy (docker-compose.prod.yaml) — tên miền đã trỏ DNS A record về IP VPS.
# Caddy tự xin chứng chỉ Let's Encrypt cho tên miền này khi container khởi động.
DOMAIN=your-domain.example.com

# Địa chỉ công khai (https), dùng cho link trong email và để bật cookie Secure/HSTS.
APP_BASE_URL=https://your-domain.example.com

# Dùng nội bộ: khóa cứng đăng ký công khai (admin không mở được từ giao diện).
ALLOW_SIGNUP=false

# Email cho xác minh tài khoản và quên mật khẩu — xem các ví dụ trong .env.example.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# AI đọc ảnh/âm thanh/video qua Gemini (tệp rời khỏi VPS). false nếu dữ liệu nhạy cảm.
AI_MEDIA_ANALYSIS=true
