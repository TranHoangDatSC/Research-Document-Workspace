# Copy thành .env rồi thay 3 password. Không commit .env.
# Không đổi tên DB/user/password khi đã có volume dữ liệu (xem README).

# PostgreSQL
POSTGRES_DB=research_document_workspace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MONGO_DB=research_document_workspace

# MinIO (password tối thiểu 8 ký tự)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MINIO_BUCKET=research-documents-workspace

# Đăng nhập (Ngày 6). SESSION_SECRET ký cookie đăng nhập — chuỗi ngẫu nhiên
# dài, không dùng lại giá trị này. ADMIN_USERNAME/PASSWORD chỉ được dùng MỘT
# LẦN khi bảng users còn trống, để tạo tài khoản admin đầu tiên; đổi mật khẩu
# này ngay sau khi đăng nhập lần đầu (chưa có tính năng đổi mật khẩu qua UI,
# tạo tài khoản admin khác rồi khóa tài khoản seed nếu cần).
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Hỏi đáp AI (RAG thu nhỏ, đọc app/rag.py + app/llm.py) — tùy chọn, bỏ trống
# thì nút "Hỏi" trên trang project chỉ báo lỗi rõ ràng, không crash app.
#
# Lấy API key MIỄN PHÍ (Gemini, khuyến nghị — có free tier thật, không cần thẻ
# tín dụng):
#   1. Vào https://aistudio.google.com/apikey (đăng nhập tài khoản Google).
#   2. Bấm "Create API key", copy chuỗi bắt đầu bằng "AIza...".
#   3. Dán vào LLM_API_KEY dưới đây. KHÔNG commit .env chứa key thật lên Git.
# Free tier có giới hạn số request/phút — đủ dùng để demo, không dùng cho tải lớn.
#
# Muốn dùng OpenAI thay vì Gemini: đặt LLM_PROVIDER=openai, LLM_API_KEY lấy từ
# https://platform.openai.com/api-keys — LƯU Ý: OpenAI hiện không có free tier
# dài hạn (chỉ có credit thử miễn phí cho tài khoản mới, hết là phải trả tiền).
#
# Free tier hay trả về lỗi 503 ("model overloaded") vào giờ cao điểm — đây là
# lỗi TẠM THỜI của model, không phải hết quota. App tự xoay qua model khác khi
# gặp 503 (thử hết LLM_MODELS trước khi báo lỗi), và xoay qua key khác khi một
# key bị giới hạn (429). Điền LLM_MODELS/LLM_API_KEYS (phân cách bằng dấu
# phẩy) nếu có nhiều lựa chọn muốn thử; để trống thì dùng LLM_MODEL/LLM_API_KEY
# đơn lẻ ở dưới như bình thường, không bắt buộc phải điền cả 4 biến.
#
# Tên model Gemini đổi khá thường xuyên — "gemini-flash-latest" là alias do
# Google tự cập nhật (không cần sửa .env khi Google đổi model), an toàn làm
# lựa chọn đầu tiên. Muốn ghim đúng một dải phiên bản để xoay (ví dụ đã có
# quyền dùng gemini-3.5 → 3.8), liệt kê rõ trong LLM_MODELS — kiểm tra tên
# thật đang dùng được cho key của bạn tại:
#   https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
# LLM_API_KEYS=key-thu-nhat,key-thu-hai
# LLM_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
#
# Model được thử LẦN LƯỢT theo đúng thứ tự trên (không chạy đua song song) —
# đặt model tốt nhất lên đầu. Timeout mỗi lượt thử (giây), mặc định 45:
# LLM_TIMEOUT_SECONDS=45
# Giới hạn token "suy nghĩ" của model thinking (gemini-2.5 / -latest) để trả
# lời nhanh hơn. Để trống = mặc định của model. 0 = tắt (chỉ 2.5-flash nhận 0).
# Model đời mới có thể từ chối trường này (HTTP 400) — khi đó bỏ trống lại.
# LLM_THINKING_BUDGET=1024

# Domain của trợ lý AI (persona, quy tắc, temperature, cấu hình truy xuất):
# thư mục app/domains/<tên>/. Thiếu thư mục thì tự dùng "research".
APP_DOMAIN=research
