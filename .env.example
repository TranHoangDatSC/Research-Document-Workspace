# Copy thành .env rồi thay 3 password. Không commit .env.
# Không đổi tên DB/user/password khi đã có volume dữ liệu (xem README).

# PostgreSQL
POSTGRES_DB=research_document_workspace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MONGO_DB=research_document_workspace

# MinIO (password tối thiểu 8 ký tự)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MINIO_BUCKET=research-documents-workspace

# Redis: bộ đếm giới hạn tần suất dùng chung (xem docs/ha-tang.md mục 13).
# Chỉ dùng chữ, số, "-" và "_" (mật khẩu được ghép vào URL redis://).
# Tạo: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Đăng nhập (Ngày 6). SESSION_SECRET ký cookie đăng nhập — chuỗi ngẫu nhiên
# dài, không dùng lại giá trị này. ADMIN_USERNAME/PASSWORD chỉ được dùng MỘT
# LẦN khi bảng users còn trống, để tạo tài khoản admin đầu tiên; đổi mật khẩu
# này ngay sau khi đăng nhập lần đầu (chưa có tính năng đổi mật khẩu qua UI,
# tạo tài khoản admin khác rồi khóa tài khoản seed nếu cần).
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Đăng ký, xác minh email & quên mật khẩu.
# Đăng ký công khai ĐÓNG theo mặc định; admin mở/đóng ở trang Quản lý người
# dùng. ALLOW_SIGNUP=false là chốt chặn cứng: đóng bất kể admin chọn gì (nên
# đặt false trên VPS nếu chỉ dùng nội bộ). Tài khoản tự đăng ký phải bấm link
# xác minh trong email mới đăng nhập được; admin có thể "Xác minh hộ".
ALLOW_SIGNUP=true
# Địa chỉ công khai của web, dùng để tạo link đặt lại mật khẩu trong email.
# BẮT BUỘC khi đã điền SMTP_HOST (không suy ra từ request để tránh link giả
# mạo qua header Host). Không có dấu "/" ở cuối.
APP_BASE_URL=http://127.0.0.1:8001
#
# Gửi email (SMTP). Bỏ trống SMTP_HOST = KHÔNG gửi thật: nội dung email (kèm
# link đặt lại) được ghi vào log, xem bằng `docker compose logs web` — đủ để
# demo luồng quên mật khẩu khi chưa có key. Ví dụ điền:
#   Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURITY=starttls
#           SMTP_USERNAME=ban@gmail.com  SMTP_PASSWORD=<App password 16 ký tự,
#           tạo ở https://myaccount.google.com/apppasswords, cần bật 2FA>
#   Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  (key SMTP trong
#           trang SMTP & API của Brevo; có gói miễn phí theo ngày)
#   Resend: SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURITY=ssl
#           SMTP_USERNAME=resend  SMTP_PASSWORD=<API key re_...>
# SMTP_FROM là địa chỉ người gửi hiển thị; với Brevo/Resend phải là domain
# hoặc email đã xác minh với nhà cung cấp.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Hỏi đáp AI (RAG thu nhỏ, đọc app/rag.py + app/llm.py) — tùy chọn, bỏ trống
# thì nút "Hỏi" trên trang project chỉ báo lỗi rõ ràng, không crash app.
#
# Lấy API key MIỄN PHÍ (Gemini, khuyến nghị — có free tier thật, không cần thẻ
# tín dụng):
#   1. Vào https://aistudio.google.com/apikey (đăng nhập tài khoản Google).
#   2. Bấm "Create API key", copy chuỗi bắt đầu bằng "AIza...".
#   3. Dán vào LLM_API_KEY dưới đây. KHÔNG commit .env chứa key thật lên Git.
# Free tier có giới hạn số request/phút — đủ dùng để demo, không dùng cho tải lớn.
#
# Muốn dùng OpenAI thay vì Gemini: đặt LLM_PROVIDER=openai, LLM_API_KEY lấy từ
# https://platform.openai.com/api-keys — LƯU Ý: OpenAI hiện không có free tier
# dài hạn (chỉ có credit thử miễn phí cho tài khoản mới, hết là phải trả tiền).
#
# Free tier hay trả về lỗi 503 ("model overloaded") vào giờ cao điểm — đây là
# lỗi TẠM THỜI của model, không phải hết quota. App tự xoay qua model khác khi
# gặp 503 (thử hết LLM_MODELS trước khi báo lỗi), và xoay qua key khác khi một
# key bị giới hạn (429). Điền LLM_MODELS/LLM_API_KEYS (phân cách bằng dấu
# phẩy) nếu có nhiều lựa chọn muốn thử; để trống thì dùng LLM_MODEL/LLM_API_KEY
# đơn lẻ ở dưới như bình thường, không bắt buộc phải điền cả 4 biến.
#
# Tên model Gemini đổi khá thường xuyên — "gemini-flash-latest" là alias do
# Google tự cập nhật (không cần sửa .env khi Google đổi model), an toàn làm
# lựa chọn đầu tiên. Muốn ghim đúng một dải phiên bản để xoay (ví dụ đã có
# quyền dùng gemini-3.5 → 3.8), liệt kê rõ trong LLM_MODELS — kiểm tra tên
# thật đang dùng được cho key của bạn tại:
#   https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
# LLM_API_KEYS=key-thu-nhat,key-thu-hai
# LLM_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
#
# Model được thử LẦN LƯỢT theo đúng thứ tự trên (không chạy đua song song) —
# đặt model tốt nhất lên đầu. Timeout mỗi lượt thử (giây), mặc định 45:
# LLM_TIMEOUT_SECONDS=45
# Chỉ áp dụng khi LLM_PROVIDER=openai: đổi máy chủ gọi tới, mặc định
# https://api.openai.com/v1. Trỏ sang bất kỳ máy nào nói cùng giao thức
# chat-completions, kể cả model chạy nội bộ — ví dụ Ollama chạy sẵn trên máy
# (LLM_API_KEY vẫn phải khác rỗng dù Ollama không kiểm tra, điền gì cũng được):
# LLM_BASE_URL=http://localhost:11434/v1
# Giới hạn token "suy nghĩ" của model thinking (gemini-2.5 / -latest) để trả
# lời nhanh hơn. Để trống = mặc định của model. 0 = tắt (chỉ 2.5-flash nhận 0).
# Model đời mới có thể từ chối trường này (HTTP 400) — khi đó bỏ trống lại.
# LLM_THINKING_BUDGET=1024

# Giới hạn dung lượng upload theo nhóm tệp (MiB) — xem app/file_types.py.
# Bỏ trống = mặc định: DOCUMENT 50, PRESENTATION 100, DATA 50, IMAGE 25,
# AUDIO 100, VIDEO 500, ARCHIVE 200. Upload được stream sang MinIO nên giới
# hạn lớn tốn DUNG LƯỢNG ĐĨA, không tốn RAM — kiểm tra ổ đĩa VPS trước khi nâng.
# MAX_UPLOAD_MB_VIDEO=500

# AI đọc ảnh / âm thanh / video (nút "Phân tích bằng AI" ở tab Văn bản trích
# xuất): tệp được gửi lên Gemini Files API để OCR, mô tả, chép lời; kết quả
# lưu thành văn bản cho hỏi đáp. Cần LLM_PROVIDER=gemini. Tệp RỜI KHỎI máy
# chủ (free tier: Google có thể dùng để cải thiện sản phẩm) — đặt false nếu
# dữ liệu nhạy cảm. AI_MEDIA_MAX_MB: tệp lớn hơn thì không gửi (mặc định 200).
AI_MEDIA_ANALYSIS=true
# AI_MEDIA_MAX_MB=200

# Domain của trợ lý AI (persona, quy tắc, temperature, cấu hình truy xuất):
# thư mục app/domains/<tên>/. Thiếu thư mục thì tự dùng "research".
APP_DOMAIN=research
